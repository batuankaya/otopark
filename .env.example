# ---------------------------------------------------------------------------
# Otopark Yönetim Sistemi — ortam değişkenleri
# Bu dosyayı `.env` adıyla kopyalayıp değerleri doldur:  cp .env.example .env
# ---------------------------------------------------------------------------

# PostgreSQL bağlantısı
# Lokal PostgreSQL kullanıyorsan (varsayılan, port 5432):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/otopark_dev?schema=public"
# docker-compose.yml kullanıyorsan (port 5433):
# DATABASE_URL="postgresql://otopark:otopark@localhost:5433/otopark_dev?schema=public"

# Auth.js oturum şifreleme anahtarı — ZORUNLU.
# Üretmek için:  npx auth secret     ya da     openssl rand -base64 32
AUTH_SECRET="buraya-rastgele-uzun-bir-anahtar-yazin"

# Uygulamanın çalıştığı adres (üretimde gerçek alan adı olmalı)
AUTH_URL="http://localhost:3000"

# Ters proxy / Vercel dışı ortamlarda güvenilen host kontrolü için
AUTH_TRUST_HOST="true"

# Uygulama saat dilimi (sunucu UTC saklar, gösterimde bu diline çevirir)
TZ="Europe/Istanbul"

# Seed script'inin oluşturacağı hesapların şifreleri (yalnızca geliştirme)
SEED_ADMIN_SIFRE="Admin123!"
SEED_GOREVLI_SIFRE="Gorevli123!"
