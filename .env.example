# ---------------------------------------------------------------------------
# Otopark Yönetim Sistemi — ortam değişkenleri
# Bu dosyayı `.env` adıyla kopyalayıp değerleri doldur:  cp .env.example .env
# ---------------------------------------------------------------------------

# PostgreSQL bağlantısı
# Lokal PostgreSQL kullanıyorsan (varsayılan, port 5432):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/otopark_dev?schema=public"
# docker-compose.yml kullanıyorsan (port 5433):
# DATABASE_URL="postgresql://otopark:otopark@localhost:5433/otopark_dev?schema=public"

# Auth.js oturum şifreleme anahtarı — ZORUNLU.
# Üretmek için:  npx auth secret     ya da     openssl rand -base64 32
# Bu anahtar değişirse tüm açık oturumlar düşer.
AUTH_SECRET="buraya-rastgele-uzun-bir-anahtar-yazin"

# Uygulamanın çalıştığı adres.
# ÜRETİMDE https:// ile gerçek alan adı olmalı — http kalırsa oturum çerezi
# güvenli moda geçmez ve şifreler ağda düz metin gider.
AUTH_URL="http://localhost:3000"

# Ters proxy (nginx, Caddy, Cloudflare) arkasındaysa true.
# Proxy'nin X-Forwarded-Proto ve X-Forwarded-Host başlıklarını doğru
# ilettiğinden emin olun; aksi hâlde sahte Host ile yönlendirme yapılabilir.
AUTH_TRUST_HOST="true"

# Uygulama saat dilimi (sunucu UTC saklar, gösterimde bu diline çevirir)
TZ="Europe/Istanbul"

# Seed script'inin oluşturacağı hesapların şifreleri.
# ÜRETİMDE bunları değiştirin — varsayılanlar depoda herkese açık yazılı.
SEED_ADMIN_SIFRE="Admin123!"
SEED_GOREVLI_SIFRE="Gorevli123!"

# ---------------------------------------------------------------------------
# ÜRETİM KONTROL LİSTESİ
# ---------------------------------------------------------------------------
# 1) NODE_ENV=production ile çalıştırın (npm run build && npm start).
#    Bu, güvenli çerezleri (__Secure- öneki), HSTS başlığını ve sıkı CSP'yi
#    devreye alır.
# 2) HTTPS kurun. Sertifika olmadan HSTS siteyi erişilemez yapar.
#    Yerel ağda: Caddy ya da mkcert ile kendinden imzalı sertifika yeterli.
# 3) AUTH_SECRET'i yeniden üretin (npx auth secret) — .env.example'daki
#    örnek değeri asla kullanmayın.
# 4) Seed hesaplarının şifrelerini Ayarlar > Kullanıcılar'dan değiştirin.
# 5) Veritabanı yedeklemesini kurun — şu an tek kopya var.
# ---------------------------------------------------------------------------
